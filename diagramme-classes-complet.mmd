    %% ===== 1. HIÉRARCHIE UTILISATEUR =====

    class Utilisateur {
        +id: ObjectId
        +nom: String
        +email: String
        +motDePasseHash: String
        +telephone: String
        +genre: String
        +avatar: String
        +role: String
        +estActif: Boolean
        +derniereConnexion: Date
        +derniereActivite: Date
        +dateCreation: Date
        +dateModification: Date
        +connecter() void
        +deconnecter() void
        +reinitialiserMotDePasse() void
    }

    class Visiteur {
        +datePremiereVisite: Date
        +consulterOffres() void
        +envoyerDevis() void
        +contacterAdmin() void
    }

    class Apiculteur {
        +id: ObjectId
        +nom: String
        +email: String
        +telephone: String
        +avatar: String
        +genre: String
        +region: String
        +totalRuches: Number
        +totalFermes: Number
        +adresse: String
        +latitude: Number
        +longitude: Number
        +userId: ObjectId
        +dateCreation: Date
        +dateModification: Date
        +appairerRuche() void
        +consulterTableauDeBord() void
        +envoyerDemandeMaintenance() void
    }

    class Administrateur {
        +codeAcces: String
        +derniereConnexion: Date
        +creerCompteApiculteur() void
        +gererComptes() void
        +consulterTableauDeBord() void
        +traiterDemandeMaintenance() void
    }

    class SuperAdmin {
        +creerCompteAdmin() void
        +gererAdministrateurs() void
        +consulterAudit() void
        +reinitialiserCodeAdmin() void
        +telechargerRapport() void
    }

    Utilisateur <|-- Visiteur : hérite
    Utilisateur <|-- Apiculteur : hérite
    Utilisateur <|-- Administrateur : hérite
    Administrateur <|-- SuperAdmin : hérite

